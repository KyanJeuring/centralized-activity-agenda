# Backend environment template for local development
# Copy to .env (or set env vars in Docker/CI) and customize as needed.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:change_me@127.0.0.1:5432/app?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###
